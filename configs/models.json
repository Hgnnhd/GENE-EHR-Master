{
  "label_mode": "verified",
  "max_len": 64,
  "pretrain_max_len": 128,
  "num_workers": 4,
  "seed": 42,
  "pretrain": {
    "epochs": 40, "batch_size": 512, "lr": 5e-4, "weight_decay": 0.01, "warmup_frac": 0.05,
    "mask_prob": 0.15, "patience": 4
  },
  "train": {
    "epochs": 30, "batch_size": 512, "lr": 1e-3, "finetune_lr": 1e-4, "weight_decay": 0.01,
    "warmup_frac": 0.05, "patience": 4
  },
  "deep_models": {
    "mlp":             {"family": "bag",         "hidden": [512, 256], "dropout": 0.2},
    "gru":             {"family": "rnn",         "cell": "gru",  "d_model": 256, "layers": 2, "dropout": 0.1},
    "lstm":            {"family": "rnn",         "cell": "lstm", "d_model": 256, "layers": 2, "dropout": 0.1},
    "retain":          {"family": "retain",      "d_model": 128, "dropout": 0.1},
    "dipole":          {"family": "dipole",      "d_model": 128, "dropout": 0.1},
    "transformer":     {"family": "transformer", "embedding": "basic",   "d_model": 256, "layers": 4, "heads": 8, "dropout": 0.1, "pretrain": false},
    "behrt":           {"family": "transformer", "embedding": "behrt",   "d_model": 256, "layers": 6, "heads": 8, "dropout": 0.1, "pretrain": true},
    "medbert":         {"family": "transformer", "embedding": "medbert", "d_model": 256, "layers": 6, "heads": 8, "dropout": 0.1, "pretrain": true},
    "ehr_transformer": {"family": "transformer", "embedding": "time",    "d_model": 256, "layers": 6, "heads": 8, "dropout": 0.1, "pretrain": true}
  },
  "classical_models": {
    "logistic_regression": {"C": 0.1, "max_iter": 2000},
    "random_forest":       {"n_estimators": 300, "min_samples_leaf": 50, "max_samples": 0.3, "max_features": "sqrt"},
    "lightgbm":            {"n_estimators": 2000, "learning_rate": 0.05, "num_leaves": 63, "min_child_samples": 100,
                            "subsample": 0.8, "subsample_freq": 1, "colsample_bytree": 0.5, "early_stopping_rounds": 50},
    "xgboost":             {"n_estimators": 2000, "learning_rate": 0.05, "max_depth": 6, "min_child_weight": 10,
                            "subsample": 0.8, "colsample_bytree": 0.5, "early_stopping_rounds": 50}
  },
  "evaluate": {"bootstrap": 200, "split": "test"}
}
